# General configuration for C files
IndentWidth: 4
ColumnLimit: 0
SortIncludes: false                    # DO NOT CHANGE
AlignTrailingComments: true            # Do not align comments
AlignConsecutiveDeclarations: false    # Align consecutive declarations
AlignConsecutiveAssignments: false     # Align consecutive assignments
PointerAlignment: Left                 # Asterisk closest to type
AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: false
SpacesBeforeTrailingComments: 1
