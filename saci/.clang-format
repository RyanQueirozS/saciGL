# General
SortIncludes: false # Can break stb and opengl
IndentWidth: 4
ColumnLimit: 0  # this can creates some really ugly indentation but try to avoid over 80 char per line
SpacesBeforeTrailingComments: 1

# Indentation width for preprocessor directives
PPIndentWidth: 2              
IndentPPDirectives: AfterHash

# Asterisk closest to the type
DerivePointerAlignment: false
PointerAlignment: Left

AllowAllParametersOfDeclarationOnNextLine: true  # Allows parameters to go to the next line

IndentCaseBlocks: true 

BreakBeforeBraces: Custom
BraceWrapping:
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: false
  BeforeWhile: false
  SplitEmptyFunction: true
  AfterExternBlock: true
  AfterCaseLabel: true
  AfterFunction: true
