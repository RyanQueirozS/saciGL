Checks: >
  -*,
  clang-analyzer-*,
  cert-*,
  bugprone-*,
  portability-*,
  modernize-*,
  readability-braces-around-statements,
  readability-else-after-return,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-misleading-indentation,
  readability-simplify-boolean-expr,
  readability-avoid-bad-function
  readability-avoid-magic-numbers,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
CheckOptions:

  - key: readability-avoid-bad-function.Functions
  value: 'free:Use su_FREE_M instead, malloc:Use su_MALLOC_M instead, calloc:Use su_CALLOC_M instead'

  # Functions There needs to be a check for static functions
  - key: readability-identifier-naming.FunctionPrefix
    value: "saci__"
  - key: readability-identifier-naming.FunctionCase
    value: lower_case 
  - key: readability-identifier-naming.GlobalFunctionPrefix
    value: "saci_"

  # Variables
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: "saci_"
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.StaticVariablePrefix
    value: "saci__"
  - key: readability-identifier-naming.StaticConstantPrefix
    value: "saci__"
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Constants
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: "saci_"
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstantPointerParameterCase
    value: lower_case
  - key: readability-identifier-naming.StaticConstantPrefix
    value: "saci__"

  # Structs
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.StructPrefix
    value: "saci_"
  - key: readability-identifier-naming.MemberCase
    value: lower_case

  # Enums
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumPrefix
    value: "saci_"
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantPrefix
    value: "saci_"

  # Typedefs
  - key: readability-identifier-naming.TypedefCase
    value: camelCase
  - key: readability-identifier-naming.TypedefPrefix
    value: "saci_"

  # Macros
  - key: readability-identifier-naming.MacroDefinitionCase
    value: ALL_CAPS
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: "saci_"
  # Function macros need a _m suffix
  # - key: readability-identifier-naming.MacroDefinitionSuffix
  #   value: "_m"
